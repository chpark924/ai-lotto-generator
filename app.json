{
  "expo": {
    "name": "금손로또",
    "slug": "ai-lotto-generator",
    "scheme": "geumsonlotto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geumsonlotto.app"
    },
    "android": {
      "package": "com.geumsonlotto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "androidNavigationBar": {
      "enforceContrast": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "구매한 로또 용지의 QR코드를 스캔해 당첨 여부를 확인하려면 카메라 접근 권한이 필요합니다. 촬영된 이미지는 기기에 저장되거나 외부로 전송되지 않습니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "41bb14e7-a845-446f-a38d-c58aa4ab7419"
      }
    }
  }
}
